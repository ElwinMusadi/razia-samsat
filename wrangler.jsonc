{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "razia-samsat-local", "main": "worker/index.ts", "compatibility_date": "2026-10-07",
  "workers_dev": false, "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"] },
  // LOCAL placeholders only. Replace after resource/plan/domain approval; do not deploy this config.
  "d1_databases": [{ "binding": "DB", "database_name": "razia-samsat-LOCAL-PLACEHOLDER", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations", "remote": false }],
  "kv_namespaces": [{ "binding": "VEHICLE_CACHE", "id": "00000000000000000000000000000000", "remote": false }],
  "vars": {
    "RETENTION_POLICY": "UNSET",
    // LOCAL baseline only; the separate final production configuration uses the approved value 10.
    // Runtime accepts canonical iteration counts in 10..100000, including legacy hashes.
    "PASSWORD_PBKDF2_ITERATIONS": "100000",
    // Approved absolute session lifetime (12 hours). Runtime accepts 1..34560000.
    "SESSION_TTL_SECONDS": "43200"
  },
  // Automatic invocation URLs and subrequest traces may contain sensitive user input.
  // Phase 5 must review privacy before enabling managed telemetry in production.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false }, "traces": { "enabled": false } }
}
